# Copy this file to `.env` and fill in your values.
# The .env file is gitignored — never commit real keys.

# Alpha Vantage (free key: https://www.alphavantage.co/support/#api-key)
# Anchors forex/metals/stocks to real market prices (~daily, quota-friendly).
ALPHAVANTAGE_KEY=

# Email for OTP codes. TWO options:
#
# A) Brevo HTTP API (works on hosts that block SMTP, e.g. Render free tier).
#    Sign up at brevo.com, verify your sender domain, create an API key:
BREVO_API_KEY=
#
# B) SMTP (only where outbound SMTP ports are open — most PaaS block them):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
#
# Sender identity (used by both options):
SMTP_FROM=NovaTrade <info@nova-market.trade>
# Branding shown in the OTP email signature/footer
SUPPORT_EMAIL=info@nova-market.trade
SITE_URL=https://nova-market.trade
# BRAND_NAME=NovaTrade

# Admin accounts (comma-separated emails). These users see the admin panel
# and can approve/reject deposit & withdrawal requests.
ADMIN_EMAILS=

# USDT deposit addresses shown to users (QR codes are generated
# automatically). Defaults are baked into server/index.js — override here.
# USDT_BEP20_ADDRESS=0x...
# USDT_TRC20_ADDRESS=T...

# MongoDB (optional — without it users are stored in data/db.json)
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net
MONGODB_URI=
# MONGODB_DB=novatrade

# Optional overrides
# PORT=3000
# BINANCE_REST=https://api.binance.com
# BINANCE_WS=wss://stream.binance.com:9443

# Twelve Data (https://twelvedata.com) — real forex, metals and stock prices.
# Without a key those assets stay simulated (crypto uses Binance and needs no key).
TWELVEDATA_API_KEY=
# Credits/minute your plan allows: Basic/free = 8, Grow = 55, Pro = 610.
# The poll interval is derived from this so you never exceed the limit.
# TWELVEDATA_CREDITS_PER_MIN=55

# OTC engine: master secret behind the daily price seeds. Set this so the
# published fairness commitments stay verifiable across redeploys — without
# it a new secret is generated on every restart.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTC_MASTER_SECRET=
# Daily credit allowance for your Twelve Data plan (Basic/free = 800; paid
# plans have no daily cap, so leave this unset on Grow and above). When the
# allowance runs out, assets trade as OTC until it resets at 00:00 UTC.
# TWELVEDATA_CREDITS_PER_DAY=800
# Optional UTC window to concentrate the daily credit allowance in, e.g.
# 09:00-17:00. Outside it no quotes are bought and assets trade as OTC, so
# a small plan can be genuinely live during your busiest hours instead of
# burning its budget overnight. Leave unset to spread across the whole day.
# TWELVEDATA_ACTIVE_HOURS=09:00-17:00

# Stale-feed stake protection. An asset whose real feed updates slower than
# SLOW_FEED_MS has its per-trade stake capped, because a chart trailing the
# true market can be traded against by anyone watching that market elsewhere.
# Fast feeds (Binance push stream, or Twelve Data on a paid plan) are never
# capped, and OTC assets are never capped (synthetic, no outside reference).
# SLOW_FEED_MS=20000
# SLOW_FEED_MAX_TRADE=100
