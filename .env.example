# Copy this file to `.env` and fill in your values.
# The .env file is gitignored — never commit real keys.

# Alpha Vantage (free key: https://www.alphavantage.co/support/#api-key)
# Anchors forex/metals/stocks to real market prices (~daily, quota-friendly).
ALPHAVANTAGE_KEY=

# SMTP for sending OTP verification emails (dev mode prints codes to console)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Admin accounts (comma-separated emails). These users see the admin panel
# and can approve/reject deposit & withdrawal requests.
ADMIN_EMAILS=

# USDT deposit addresses shown to users (QR codes are generated
# automatically). Defaults are baked into server/index.js — override here.
# USDT_BEP20_ADDRESS=0x...
# USDT_TRC20_ADDRESS=T...

# MongoDB (optional — without it users are stored in data/db.json)
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net
MONGODB_URI=
# MONGODB_DB=novatrade

# Optional overrides
# PORT=3000
# BINANCE_REST=https://api.binance.com
# BINANCE_WS=wss://stream.binance.com:9443
